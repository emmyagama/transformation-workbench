{
  "pack_id": "level2-evaluation-pack",
  "pack_version": "1.0.0",
  "corpus_version": "1.0.0",
  "status": "frozen",
  "frozen_at": "2026-11-19",
  "frozen_by": "owner",
  "baseline_commit": "d5a6c973cae4ee17cd66ed01352a64c159ceb0f8",
  "scope": "Formative local evaluation of the CLI/A2A/MCP workflow. Synthetic fixture only. Not a statistical benchmark.",
  "partial_completion_policy": {
    "decision": "whole_workflow_failure",
    "decision_date": "2026-11-19",
    "rule": "If either specialist fails, the workflow must return a bounded failure. It must not return a result labeled complete or partial.",
    "rationale": "The current schema has no safe partial-result representation. A whole-workflow failure is truthful and avoids implying full completion."
  },
  "permitted_tools": [
    "calculate_baseline_metrics",
    "list_case_exceptions",
    "get_case_details"
  ],
  "permitted_resource": "workbench://process-context",
  "forbidden_actions": [
    "write",
    "create_ticket",
    "send_email",
    "shell_or_command_execution",
    "non_loopback_network",
    "approval_bypass"
  ],
  "status_vocabulary": {
    "complete": "The workflow produced a report and stopped at the approval checkpoint.",
    "refused": "The request was rejected before consequential work, with a bounded error.",
    "failure": "A bounded workflow or protocol failure terminated without a successful result.",
    "partial": "Not permitted in v1. A partial-completion attempt must be a failure."
  },
  "cases": [
    {
      "case_id": "L2-01",
